1:[["$","section",null,{"className":"page-intro wrap","children":[["$","p",null,{"className":"eyebrow ","children":[["$","span",null,{}],"YOUR QUESTIONS, ANSWERED"]}],["$","h1",null,{"children":["A little clarity.",["$","br",null,{}],["$","em",null,{"children":"Before we begin."}]]}],["$","p",null,{"children":"Practical answers to the questions that often come with an interior project."}]]}],["$","section",null,{"className":"wrap policy","children":[["$","p",null,{"className":"notice mb-8","children":"These are general project considerations for a fictional studio. Fees, warranties, payment terms, timelines and availability require confirmation by the actual company."}],["$","$Lf",null,{"items":[{"q":"How much does an interior-design project cost?","a":"Cost depends on the area, scope, materials, site condition and level of customisation. Start with a budget range, then ask for an itemised quotation with clear inclusions and exclusions. This demo publishes no studio prices.","category":"Budget"},{"q":"Is the initial consultation free or paid?","a":"Consultation and site-visit fees need to be confirmed by the real studio. Ask what the session includes and whether any fee is adjusted against a later project. No free-consultation policy is implied here.","category":"Getting started"},{"q":"Do you offer turnkey design and execution?","a":"Turnkey delivery is part of this illustrative service offering. A real proposal should identify the design, procurement, production and site work included, as well as exclusions and responsibilities.","category":"Services"},{"q":"Which locations do you serve?","a":"This concept is designed for clients in Chennai, including Adyar, Anna Nagar, Velachery, OMR, ECR and Porur. Actual service coverage and travel charges must be confirmed with the studio.","category":"Getting started"},{"q":"How long will my project take?","a":"A realistic programme follows the scope, approved drawings, material lead times, site access and any civil work. Ask for a project-specific schedule and how delays or late approvals will be handled. This demo does not promise a delivery duration.","category":"Process"},{"q":"Can you work with an existing floor plan?","a":"A floor plan is a useful starting point. Dimensions and services should still be verified at the site before detailed drawings or production. Mention whether your drawing is current when you enquire.","category":"Services"},{"q":"Do you design modular kitchens and wardrobes?","a":"Yes, kitchens and storage are included in the demo service offering. Layout, internal organisation, finishes, hardware and installation details should be agreed in the actual scope.","category":"Services"},{"q":"Can I select my own materials?","a":"Your preferences should inform the palette. Discuss suitability, availability, cost and maintenance before final selection, and clarify responsibility for any client-supplied products.","category":"Process"},{"q":"What about electrical, plumbing, painting and civil work?","a":"These trades may be required, particularly in a renovation. Confirm each item in the quotation, including specialist approvals where needed. They are not automatically included in every interior package.","category":"Services"},{"q":"How are payments structured?","a":"The real studio must confirm its payment terms. Ask for written milestones linked to agreed work, along with applicable taxes, cancellation terms and the process for variations. No payment schedule is promised by this demo.","category":"Budget"},{"q":"Can NRIs manage a Chennai project remotely?","a":"A remote project can be planned around video reviews, shared drawings, recorded decisions and scheduled progress updates. Confirm how site access, local authorisations and final approvals will work before proceeding.","category":"Process"},{"q":"Are warranties included?","a":"Warranty coverage depends on the actual supplier, material, hardware and installation agreement. Request written terms, exclusions and care instructions. This demo does not claim a studio warranty.","category":"Aftercare"},{"q":"What if the project scope changes?","a":"Agree on a written change process. Review the revised work, price and timing before authorising a change so that the effect on the rest of the project is clear.","category":"Process"},{"q":"How do I begin?","a":"Use the consultation form to share your property type, location, style preferences and budget range. In a connected live website, the studio would review your enquiry and get in touch; an appointment is confirmed separately. This version safely demonstrates that journey.","category":"Getting started"}]}]]}],"$L10"]
10:["$","section",null,{"className":"consult-cta","children":["$","div",null,{"className":"wrap cta-inner","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow eyebrow-light","children":[["$","span",null,{}],"LET’S BEGIN WITH A CONVERSATION"]}],["$","h2",null,{"children":["Your space.",["$","br",null,{}],["$","em",null,{"children":"A new perspective."}]]}]]}],["$","div",null,{"className":"cta-copy","children":[["$","p",null,{"children":"A new home, a better kitchen, or simply a place that feels more like you. Tell us what you have in mind."}],["$","a",null,{"href":"/aara-and-grain-demo/consultation","className":"button button-light","children":["Discuss your project ",["$","$L6",null,{"ref":"$undefined","iconNode":"$2:1:props:children:props:children:3:0:props:children:0:props:children:2:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":18}]]}],["$","span",null,{"className":"small","children":"An enquiry is the first step. Appointments are agreed separately."}]]}]]}]}]
