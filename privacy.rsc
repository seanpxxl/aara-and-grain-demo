1:[["$","section",null,{"className":"page-intro wrap","children":[["$","p",null,{"className":"eyebrow ","children":[["$","span",null,{}],"PRIVACY"]}],["$","h1",null,{"children":["Your details.",["$","br",null,{}],["$","em",null,{"children":"Handled thoughtfully."}]]}],["$","p",null,{"children":"This notice describes the demonstration website as delivered. It must be reviewed and replaced with the client studio’s approved notice before live enquiries are enabled."}]]}],["$","article",null,{"className":"wrap policy","children":[["$","p",null,{"className":"notice","children":"Aara & Grain is a fictional brand. The delivered site runs in demonstration mode and does not deliver enquiries to a business."}],["$","h2",null,{"children":"What happens to demo form entries?"}],["$","p",null,{"children":"Consultation and contact entries remain in the current page’s memory. They are not written to browser storage, a database or an inbox. Completing the demo displays a demonstration result. Refreshing or leaving the page clears the entries. Use sample details when exploring the site."}],["$","h2",null,{"children":"WhatsApp and copying your message"}],["$","p",null,{"children":"The WhatsApp preview assembles a message using the details you have entered. Copying it places those details on your device’s clipboard. A WhatsApp link appears only after the studio adds a valid business number. If you choose to open that link, the message text is passed to WhatsApp, whose own privacy terms apply. You choose whether to send it there."}],["$","h2",null,{"children":"Cookies, images and hosting"}],["$","p",null,{"children":"No advertising pixels, analytics scripts or marketing cookies are included by this application. Images and fonts are served from this site. The hosting platform may process technical requests and essential authentication or security information under its own terms."}],["$","h2",null,{"children":"File uploads"}],["$","p",null,{"children":"File uploads are not enabled. Floor plans and reference images can be discussed during a real consultation through a channel agreed with the studio. Do not submit sensitive documents through an unverified link."}],["$","h2",null,{"children":"If the website is connected for live enquiries"}],["$","p",null,{"children":"The optional integration sends an enquiry to a verified studio inbox through Resend, following a Cloudflare Turnstile security check. It must remain disabled until the real business supplies its contact details and an approved privacy notice. That notice must explain the data collected, purpose, service providers, retention, security arrangements and how to request access or deletion."}],["$","p",null,{"children":"No retention period, business identity or statutory compliance claim is invented by this demo. The client must approve the wording and its actual handling procedures before launch."}],["$","h2",null,{"children":"Questions and requests"}],["$","p",null,{"children":"Privacy contact details have not been supplied for the fictional studio. A real studio must provide an appropriate contact before collecting enquiries."}],["$","a",null,{"href":"/aara-and-grain-demo/contact","className":"text-link","children":"View contact and demo information"}]]}]]
